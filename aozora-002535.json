   "no": 146,
   "vol": "下",
   "kotobagaki": "",
   "author": "",
   "text": "「しばしが程なり、願はくは待たせ給へ。妹を伴れて直に歸り來んに何の間も入るべき。",
   "sachu": "",
   "poems": [],
   "notes": [],
   "lb": [],
   "form": "prose"
  },
  {
   "id": "aozora-002535-000147",
